# mock | openai | qwen | local
ANALYZER=mock

# OpenAI (or any OpenAI-compatible host)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Hosted Qwen-VL or another OpenAI-compatible vision endpoint
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen2.5-vl-7b-instruct

# Longest edge photos are resized to before analysis. Lower = cheaper.
MAX_IMAGE_EDGE=512
